# Postgres — set POSTGRES_DB (required). DATABASE_URL optional; its path wins when set.
# Local dev: copy repo-root `.env.local.example` → `.env.local` (loaded by npm run dev / migrations).
DATABASE_URL=postgresql://serveaso:serveaso@127.0.0.1:5432/serveaso1

# Or discrete vars (used when DATABASE_URL is unset)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=serveaso
POSTGRES_PASSWORD=serveaso
POSTGRES_DB=serveaso1